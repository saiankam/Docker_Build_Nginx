
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ShopEasy - Online Shopping</title>

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: Arial, sans-serif;
}

body {
    background: #f1f3f6;
    color: #212121;
}

/* Header */
header {
    background: #2874f0;
    color: white;
    padding: 15px 5%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
    flex-wrap: wrap;
}

.logo {
    font-size: 27px;
    font-weight: bold;
}

.logo span {
    color: #ffe500;
}

.search-box {
    display: flex;
    flex: 1;
    max-width: 550px;
}

.search-box input {
    width: 100%;
    padding: 12px;
    border: none;
    outline: none;
    border-radius: 5px 0 0 5px;
}

.search-box button {
    border: none;
    background: #ffdf00;
    padding: 12px 18px;
    cursor: pointer;
    border-radius: 0 5px 5px 0;
}

.header-btn {
    border: none;
    background: white;
    color: #2874f0;
    padding: 11px 18px;
    border-radius: 5px;
    font-weight: bold;
    cursor: pointer;
}

/* Categories */
.categories {
    background: white;
    display: flex;
    justify-content: center;
    gap: 35px;
    padding: 20px;
    flex-wrap: wrap;
    box-shadow: 0 2px 6px #0001;
}

.category {
    text-align: center;
    cursor: pointer;
    font-weight: bold;
    font-size: 14px;
    border: none;
    background: transparent;
}

.category span {
    display: block;
    font-size: 30px;
    margin-bottom: 8px;
}

/* Hero banner */
.hero {
    margin: 22px auto;
    width: 92%;
    min-height: 300px;
    border-radius: 12px;
    background: linear-gradient(120deg, #092b72, #2874f0, #7ca9ff);
    display: flex;
    align-items: center;
    justify-content: space-around;
    color: white;
    padding: 35px;
    gap: 20px;
}

.hero h1 {
    font-size: clamp(32px, 5vw, 50px);
    margin-bottom: 15px;
}

.hero p {
    line-height: 1.7;
}

.hero button {
    margin-top: 20px;
    padding: 13px 23px;
    background: #ffdf00;
    border: none;
    border-radius: 5px;
    font-weight: bold;
    cursor: pointer;
}

.hero-art {
    font-size: clamp(75px, 12vw, 145px);
}

/* Product section */
.section-title {
    margin: 30px 4% 20px;
    font-size: 25px;
}

.products {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
    padding: 0 4%;
}

.product {
    background: white;
    border-radius: 10px;
    overflow: hidden;
    text-align: center;
    padding-bottom: 18px;
    box-shadow: 0 3px 12px #0000000b;
    transition: 0.25s;
}

.product:hover {
    transform: translateY(-5px);
    box-shadow: 0 8px 22px #00000015;
}

.product-image {
    height: 175px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #eaf1ff;
    font-size: 75px;
}

.product h3 {
    margin: 15px 8px 10px;
    font-size: 17px;
}

.rating {
    color: #168348;
    font-size: 13px;
    margin-bottom: 10px;
}

.price {
    color: #222;
    font-size: 21px;
    font-weight: bold;
}

.old-price {
    color: #888;
    text-decoration: line-through;
    font-size: 13px;
    margin-left: 6px;
}

.discount {
    color: #168348;
    margin-top: 7px;
    font-size: 13px;
}

.add-cart {
    margin-top: 15px;
    padding: 11px 18px;
    background: #2874f0;
    color: white;
    border: none;
    border-radius: 5px;
    cursor: pointer;
    font-weight: bold;
}

.add-cart:hover {
    background: #1556c0;
}

/* Footer */
footer {
    background: #172337;
    color: white;
    text-align: center;
    padding: 30px 15px;
    margin-top: 45px;
    line-height: 1.8;
}

/* Mobile layout */
@media (max-width: 850px) {
    .products {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px;
    }

    .categories {
        gap: 20px;
    }

    .hero {
        padding: 25px;
    }
}

@media (max-width: 480px) {
    header {
        padding: 14px;
    }

    .logo {
        font-size: 23px;
    }

    .search-box {
        order: 3;
        flex-basis: 100%;
    }

    .hero {
        width: 94%;
        padding: 20px;
        min-height: 240px;
    }

    .hero-art {
        font-size: 65px;
    }

    .product-image {
        height: 125px;
        font-size: 55px;
    }

    .product h3 {
        font-size: 14px;
    }

    .price {
        font-size: 17px;
    }
}
</style>
</head>

<body>

<header>
    <div class="logo">Shop<span>Easy</span></div>

    <form class="search-box" id="searchForm">
        <input type="text" id="searchInput"
               placeholder="Search for products...">
        <button type="submit">🔍</button>
    </form>

    <button class="header-btn" onclick="showLogin()">
        Login
    </button>

    <button class="header-btn" onclick="showCart()">
        🛒 Cart (<span id="cartCount">0</span>)
    </button>
</header>

<nav class="categories">
    <button class="category" onclick="filterProducts('All')">
        <span>🔥</span>All Products
    </button>
    <button class="category" onclick="filterProducts('Electronics')">
        <span>🎧</span>Electronics
    </button>
    <button class="category" onclick="filterProducts('Fashion')">
        <span>👟</span>Fashion
    </button>
    <button class="category" onclick="filterProducts('Mobiles')">
        <span>📱</span>Mobiles
    </button>
    <button class="category" onclick="filterProducts('Home')">
        <span>🏠</span>Home
    </button>
</nav>

<section class="hero">
    <div>
        <h1>Big Deals<br>Big Savings!</h1>
        <p>Discover amazing products at incredible prices.</p>
        <p>Shop your favorites today.</p>
        <button onclick="scrollToProducts()">SHOP NOW →</button>
    </div>

    <div class="hero-art">🛍️</div>
</section>

<h2 class="section-title" id="sectionTitle">
    Trending Products
</h2>

<section class="products" id="productList"></section>

<footer>
    <h2>ShopEasy</h2>
    <p>Your favorite online shopping destination.</p>
    <p>Secure Shopping | Great Deals | Easy Shopping</p>
    <p>© 2026 ShopEasy. All rights reserved.</p>
</footer>

<script>
const products = [
    {
        name: "Wireless Headphones",
        category: "Electronics",
        image: "🎧",
        price: 1499,
        oldPrice: 2499
    },
    {
        name: "Running Shoes",
        category: "Fashion",
        image: "👟",
        price: 1799,
        oldPrice: 2999
    },
    {
        name: "Smart Watch",
        category: "Electronics",
        image: "⌚",
        price: 2299,
        oldPrice: 3999
    },
    {
        name: "Smartphone",
        category: "Mobiles",
        image: "📱",
        price: 14999,
        oldPrice: 18999
    },
    {
        name: "Travel Backpack",
        category: "Fashion",
        image: "🎒",
        price: 899,
        oldPrice: 1499
    },
    {
        name: "Coffee Maker",
        category: "Home",
        image: "☕",
        price: 2499,
        oldPrice: 3499
    },
    {
        name: "Bluetooth Speaker",
        category: "Electronics",
        image: "🔊",
        price: 1299,
        oldPrice: 1999
    },
    {
        name: "Sunglasses",
        category: "Fashion",
        image: "🕶️",
        price: 699,
        oldPrice: 1199
    }
];

let cart = [];
let selectedCategory = "All";
let searchTerm = "";

const formatPrice = price =>
    "₹" + price.toLocaleString("en-IN");

function renderProducts() {
    const list = document.getElementById("productList");

    const filtered = products.filter(product => {
        const matchesCategory =
            selectedCategory === "All" ||
            product.category === selectedCategory;

        const matchesSearch =
            product.name.toLowerCase().includes(searchTerm);

        return matchesCategory && matchesSearch;
    });

    document.getElementById("sectionTitle").textContent =
        searchTerm ? "Search Results" :
        selectedCategory === "All" ?
        "Trending Products" : selectedCategory;

    if (filtered.length === 0) {
        list.innerHTML =
            "<p>No products found. Try another search.</p>";
        return;
    }

    list.innerHTML = filtered.map((product, index) => `
        <article class="product">
            <div class="product-image">${product.image}</div>
            <h3>${product.name}</h3>
            <div class="rating">★ 4.5 | Popular Choice</div>
            <div class="price">
                ${formatPrice(product.price)}
                <span class="old-price">
                    ${formatPrice(product.oldPrice)}
                </span>
            </div>
            <p class="discount">
                Save ${formatPrice(product.oldPrice - product.price)}
            </p>
            <button class="add-cart" data-index="${products.indexOf(product)}">
                Add to Cart
            </button>
        </article>
    `).join("");
}

document.getElementById("productList")
    .addEventListener("click", event => {
        const button = event.target.closest("[data-index]");
        if (!button) return;

        const product = products[Number(button.dataset.index)];
        cart.push(product);

        document.getElementById("cartCount").textContent = cart.length;

        alert(product.name + " added to your cart!");
    });

function filterProducts(category) {
    selectedCategory = category;
    searchTerm = "";
    document.getElementById("searchInput").value = "";
    renderProducts();
}

document.getElementById("searchForm")
    .addEventListener("submit", event => {
        event.preventDefault();
        searchTerm = document.getElementById("searchInput")
            .value.trim().toLowerCase();
        selectedCategory = "All";
        renderProducts();
    });

function scrollToProducts() {
    document.getElementById("productList")
        .scrollIntoView({ behavior: "smooth" });
}

function showCart() {
    if (cart.length === 0) {
        alert("Your shopping cart is empty!");
        return;
    }

    const total = cart.reduce((sum, product) =>
        sum + product.price, 0);

    alert(
        "YOUR SHOPPING CART\n\n" +
        cart.map(p => p.name + " - " + formatPrice(p.price)).join("\n") +
        "\n\nTotal: " + formatPrice(total)
    );
}

function showLogin() {
    alert("Welcome to ShopEasy! Login functionality can be added next.");
}

renderProducts();
</script>

</body>
</html>
